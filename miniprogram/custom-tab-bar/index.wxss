.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  box-sizing: border-box;
  height: calc(96rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #E4D8C7;
  background: #FFFFFF;
  box-shadow: 0 -8rpx 24rpx rgba(34, 38, 45, 0.06);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 1000;
}

.tab-inner {
  display: flex;
  width: 100%;
  height: 96rpx;
}

.tab-item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 96rpx;
  color: #756E63;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.2;
}

.tab-item-divider {
  border-left: 2rpx solid #E4D8C7;
}

.tab-item.active {
  color: #22262D;
  font-weight: 700;
}
