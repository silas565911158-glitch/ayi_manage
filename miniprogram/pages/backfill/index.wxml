<view class="page flow-page backfill-page">
  <view wx:if="{{loading}}" class="quiet">正在读取……</view>

  <view wx:else class="backfill-shell">
    <scroll-view scroll-y class="backfill-scroll">
    <view class="flow-title">补录</view>
    <view class="flow-lead">可补最近30天内实际上工但尚未记录的日期；绿色点表示已有打卡，会自动跳过。</view>

    <view class="backfill-card">
      <view class="scope-row">
        <view>
          <view class="scope-label">可补范围</view>
          <view class="scope-value">{{earliestText}} 至 {{latestText}}</view>
        </view>
        <button class="small-button" hover-class="button-hover" bindtap="clearSelection">清空重选</button>
      </view>

      <view class="mode-row">
        <button class="mode-button {{mode === 'range' ? 'active' : ''}}" data-mode="range" bindtap="setMode">连续日期</button>
        <button class="mode-button {{mode === 'single' ? 'active' : ''}}" data-mode="single" bindtap="setMode">单日修改</button>
      </view>
      <view class="selection-status">{{selectionText}}</view>

      <view wx:for="{{board.boards}}" wx:for-item="month" wx:key="title" class="month-board">
        <view class="board-title">{{month.title}}</view>
        <view class="weekday-row"><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text><text>日</text></view>
        <view wx:for="{{month.weeks}}" wx:for-item="week" wx:for-index="weekIndex" wx:key="weekIndex" class="board-week">
          <view
            wx:for="{{week}}"
            wx:for-item="day"
            wx:key="index"
            class="board-day {{day.blank ? 'blank' : ''}} {{day.selected ? 'selected' : ''}} {{day.rangeMiddle ? 'range-middle' : ''}} {{day.selected && day.rangeStart ? 'range-start' : ''}} {{day.selected && day.rangeEnd ? 'range-end' : ''}} {{day.eligible ? '' : 'disabled'}}"
            data-date="{{day.date}}"
            bindtap="selectDay"
          >
            <text>{{day.day || ''}}</text>
            <view wx:if="{{day.checked}}" class="checked-dot"></view>
          </view>
        </view>
      </view>
      <view wx:if="{{!state.backfill.eligibleLocalDates.length}}" class="board-empty">近30天暂无可补日期</view>
    </view>

    <view class="backfill-card">
      <view class="config-row vertical">
        <picker mode="time" value="{{workTime}}" bindchange="changeTime">
          <view class="time-box">
            <text>统一时间</text>
            <view class="time-value">{{workTime}}</view>
          </view>
        </picker>
        <view class="reason-box">
          <view class="field-label">原因</view>
          <view class="reason-list">
            <button
              wx:for="{{reasons}}"
              wx:key="*this"
              class="reason-chip {{reason === item ? 'selected' : ''}} {{item === '其他' ? ' full' : ''}}"
              data-reason="{{item}}"
              bindtap="selectReason"
            >{{item}}</button>
          </view>
          <textarea
            wx:if="{{reason === '其他'}}"
            class="other-input"
            value="{{otherReason}}"
            bindinput="inputOtherReason"
            maxlength="120"
            placeholder="填写具体原因"
          />
        </view>
      </view>
    </view>

    <view wx:if="{{error}}" class="status-error">{{error}}</view>
    </scroll-view>

    <view class="backfill-footer">
      <view class="backfill-total">
        <view class="backfill-total-copy">
          <view class="backfill-total-days">将补 {{selectedCount}} 天</view>
          <view class="backfill-total-detail">统一 {{workTime}} · {{reason === '其他' ? (otherReason || '其他') : reason}}</view>
        </view>
        <view
          class="backfill-confirm {{submitting || selectedCount < 1 ? 'disabled' : ''}}"
          hover-class="{{submitting || selectedCount < 1 ? 'none' : 'button-hover'}}"
          bindtap="submit"
        >{{submitting ? '正在补录…' : '补录'}}</view>
      </view>
    </view>
  </view>
</view>
