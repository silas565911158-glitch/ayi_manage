.history-page {
  padding-top: 24rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.history-header {
  padding: 20rpx;
  border: 2rpx solid #E4D8C7;
  border-radius: 32rpx;
  background: #FFFDFA;
  box-shadow: 0 10rpx 30rpx rgba(34, 38, 45, 0.06);
}

.history-tabs {
  width: 100%;
  height: 104rpx;
  box-sizing: border-box;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #F4EDE1;
  white-space: nowrap;
}

.history-tab-list {
  display: flex;
  min-width: 100%;
}

.history-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 0 auto;
  min-width: 176rpx;
  height: 88rpx;
  border-radius: 999rpx;
  color: #6B6459;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 88rpx;
  text-align: center;
}

.history-tab.active {
  background: #FFFFFF;
  color: #146247;
  box-shadow: 0 6rpx 18rpx rgba(34, 38, 45, 0.10);
}

.summary-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.summary-grid > view {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.summary-label {
  color: #6B6459;
  font-size: 24rpx;
  line-height: 30rpx;
}

.summary-value {
  margin-top: 2rpx;
  color: #22262D;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 44rpx;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.contract-group {
  margin-top: 20rpx;
  padding: 24rpx;
  border: 2rpx solid #E4D8C7;
  border-radius: 32rpx;
  background: #FFFDFA;
  box-shadow: 0 10rpx 30rpx rgba(34, 38, 45, 0.06);
}

.group-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: #22262D;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.group-status {
  flex: 0 0 auto;
  color: #6B6459;
  font-size: 24rpx;
  font-weight: 700;
}

.group-status.active,
.status-pill {
  color: #146247;
}

.group-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 20rpx;
  margin-top: 12rpx;
  color: #6B6459;
  font-size: 24rpx;
  line-height: 34rpx;
}

.contract-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  height: 96rpx;
  margin-top: 18rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: #F7F1E8;
}

.contract-toggle-title {
  color: #22262D;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 96rpx;
}

.contract-toggle-icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(34, 38, 45, 0.08);
  transition: transform 0.18s ease;
}

.contract-toggle-icon::after {
  content: "";
  position: absolute;
  top: 15rpx;
  left: 16rpx;
  width: 14rpx;
  height: 14rpx;
  border-right: 4rpx solid #146247;
  border-bottom: 4rpx solid #146247;
  transform: rotate(45deg);
}

.contract-toggle-icon.expanded {
  transform: rotate(180deg);
}

.contract-detail {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #E4D8C7;
}

.info-row {
  display: flex;
  gap: 24rpx;
  margin-top: 18rpx;
}

.info-row:first-child {
  margin-top: 0;
}

.info-item {
  display: block;
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
}

.info-item:last-child {
  flex: 2;
}

.info-label {
  color: #6B6459;
  font-size: 24rpx;
  line-height: 34rpx;
}

.info-value {
  margin-top: 2rpx;
  color: #22262D;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 38rpx;
  word-break: break-all;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #E4F3ED;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.settlement {
  margin-top: 20rpx;
  padding: 22rpx;
  border: 2rpx solid #E4D8C7;
  border-radius: 24rpx;
  background: #FFFFFF;
}

.record-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.stage {
  color: #22262D;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.range {
  margin-top: 4rpx;
  color: #555047;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 34rpx;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.amount {
  min-width: 0;
  text-align: right;
}

.amount-value {
  color: #C9402A;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 52rpx;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.amount-label {
  margin-top: 2rpx;
  color: #6B6459;
  font-size: 24rpx;
  line-height: 30rpx;
}

.facts {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #F4EDE1;
}

.facts > view {
  flex: 1;
  min-width: 0;
}

.fact-label {
  color: #555047;
  font-size: 24rpx;
  line-height: 30rpx;
}

.fact-value {
  margin-top: 2rpx;
  color: #22262D;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 38rpx;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.proofs {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.proofs image {
  width: 94rpx;
  height: 94rpx;
  border-radius: 12rpx;
  background: #EFE7DA;
}

.empty {
  margin-top: 100rpx;
  color: #6B6459;
  font-size: 30rpx;
  text-align: center;
}
