.history-page { padding-top: 38rpx; padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }
.summary { display: flex; justify-content: space-between; gap: 20rpx; padding-bottom: 28rpx; border-bottom: 3rpx solid #22262D; }
.summary-label { color: #756E63; font-size: 30rpx; }
.summary-value { margin-top: 6rpx; color: #22262D; font-size: 40rpx; font-weight: 700; line-height: 1.2; }
.settlement { margin-top: 30rpx; padding: 28rpx; border-left: 12rpx solid #22262D; border-radius: 16rpx; background: #FFFDFA; }
.stage { color: #756E63; font-size: 30rpx; font-weight: 700; }
.range { margin-top: 8rpx; color: #22262D; font-size: 40rpx; font-weight: 700; }
.facts { display: flex; justify-content: space-between; margin-top: 16rpx; color: #555047; font-size: 30rpx; }
.calculation { margin-top: 16rpx; padding: 18rpx 20rpx; border-radius: 12rpx; background: #F4EDE1; }
.calculation-formula { color: #22262D; font-size: 34rpx; font-weight: 700; line-height: 1.35; }
.calculation-detail { margin-top: 6rpx; color: #555047; font-size: 30rpx; }
.paid { margin-top: 14rpx; color: #C9402A; font-size: 48rpx; font-weight: 700; }
.difference { margin-top: 4rpx; color: #8E2B1A; font-size: 26rpx; font-weight: 600; }
.difference-reason { margin-top: 4rpx; color: #555047; font-size: 30rpx; }
.proofs { display: flex; gap: 14rpx; margin-top: 20rpx; }
.proofs image { width: 150rpx; height: 150rpx; border-radius: 10rpx; background: #EFE7DA; }
.empty { margin-top: 80rpx; color: #756E63; text-align: center; }
