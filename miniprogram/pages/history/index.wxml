<view class="page history-page">
  <view wx:if="{{loading}}" class="quiet">正在读取……</view>

  <block wx:else>
  <view class="summary">
    <view>
      <view class="summary-label">已结算</view>
      <view class="summary-value">{{summary.settledStages}} 期</view>
    </view>
    <view>
      <view class="summary-label">{{role === 'employer' ? '累计支付' : '累计到账'}}</view>
      <view class="summary-value">{{totalPaidText}}</view>
    </view>
    <view>
      <view class="summary-label">累计干了</view>
      <view class="summary-value">{{totalSettledDaysText}} 天</view>
    </view>
  </view>

  <view class="settlement" wx:for="{{settlements}}" wx:key="_id">
    <view class="stage">第 {{item.stageIndex}} 期</view>
    <view class="range">{{item.stageStartLocalDate}} 至 {{item.workEndLocalDate}}</view>
    <view class="facts">
      <text>干了 {{item.days}} 天</text>
      <text>日薪 {{item.dailySalaryText}}</text>
    </view>
    <view class="calculation">
      <view class="calculation-formula">{{item.calculation.formulaText}} = {{item.calculation.suggestedText}}</view>
      <view class="calculation-detail">{{item.calculation.contractText}} = {{item.calculation.dailySalaryText}}</view>
      <view class="calculation-detail">{{item.calculation.calculationText}} = {{item.calculation.suggestedText}}</view>
      <view class="calculation-detail">按合同计算 {{item.calculation.suggestedText}}</view>
    </view>
    <view class="paid">实付 {{item.paidText}}</view>
    <view wx:if="{{item.calculation.differenceText}}" class="difference">{{item.calculation.differenceText}}</view>
    <view wx:if="{{item.differenceReason}}" class="difference-reason">原因：{{item.differenceReason}}</view>
    <view class="proofs" wx:if="{{item.transferProofs.length}}">
      <image wx:for="{{item.transferProofs}}" wx:for-item="proof" wx:key="fileId" src="{{proof.temporaryUrl || proof.fileId}}" mode="aspectFill" data-url="{{proof.temporaryUrl || proof.fileId}}" bindtap="previewProof" />
    </view>
  </view>
  </block>

  <view wx:if="{{!loading && !settlements.length}}" class="empty">还没有双方确认的结算记录。</view>
</view>
