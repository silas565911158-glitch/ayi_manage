.settlement-page {
  padding-top: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.settle-card {
  box-sizing: border-box;
  margin-top: 30rpx;
  padding: 30rpx;
  border: 2rpx solid #E4D8C7;
  border-radius: 32rpx;
  background: #FFFDFA;
  box-shadow: 0 10rpx 30rpx rgba(34, 38, 45, 0.06);
}

.range-title,
.mini-label,
.note {
  color: #6B6459;
  font-size: 24rpx;
  line-height: 34rpx;
}

.range {
  margin-top: 6rpx;
  color: #22262D;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 54rpx;
}

.note {
  margin-top: 8rpx;
}

.fact-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.fact-row > view {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #F4EDE1;
}

.fact {
  margin-top: 2rpx;
  color: #22262D;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 48rpx;
  font-variant-numeric: tabular-nums;
}

.calculation-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #F4EDE1;
}

.calculation-label {
  color: #6B6459;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.calculation-label.secondary {
  margin-top: 20rpx;
}

.calculation-line {
  margin-top: 6rpx;
  color: #22262D;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
  font-variant-numeric: tabular-nums;
}

.calculation-formula {
  margin-top: 12rpx;
  color: #C9402A;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.field {
  margin-top: 28rpx;
}

.money-input,
.reason-input {
  box-sizing: border-box;
  min-height: 96rpx;
  margin-top: 14rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid #D9CBB6;
  border-radius: 22rpx;
  background: #FFFFFF;
  color: #22262D;
  font-size: 40rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.reason-input {
  min-height: 88rpx;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.image-wrap,
.add-image {
  position: relative;
  width: 156rpx;
  height: 156rpx;
}

.image-wrap image {
  width: 100%;
  height: 100%;
  border-radius: 18rpx;
  background: #EFE7DA;
}

.remove {
  position: absolute;
  right: -12rpx;
  top: -12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #22262D;
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 40rpx;
}

.remove::after,
.add-image::after {
  border: 0;
}

.add-image {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 2rpx dashed #A99D89;
  border-radius: 18rpx;
  background: #FFFDFA;
  color: #6B6459;
  font-size: 48rpx;
  line-height: 1;
}
